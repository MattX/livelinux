#!/bin/busybox sh
# livelinux init: mount pseudo filesystems, print a banner, keep a shell alive.
/bin/busybox mkdir -p /proc /sys /dev /tmp /root
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev 2>/dev/null
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
mkdir -p /dev/pts /dev/shm
mount -t tmpfs tmpfs /tmp

export PATH=/bin:/sbin:/usr/bin:/usr/sbin:/demo
export HOME=/root
export TERM=vt100
export PS1='livelinux:\w # '

hostname livelinux
echo
echo "=== livelinux: $(uname -sr) booted ==="
echo "demo programs (in /demo): forker [N], spin [secs], mapper, pipepair [-f],"
echo "  slabchurn [N], fragmenter [MB], cowtouch [pages], oomer"
echo

# Keep a shell on the serial console and respawn it if it exits.
while true; do
	setsid cttyhack sh -l
	echo "livelinux: shell exited, respawning"
done
