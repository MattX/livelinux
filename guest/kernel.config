# livelinux kernel config fragment, merged onto `ARCH=i386 i386_defconfig`.
# build.sh verifies that every option listed in CRITICAL_CONFIG (build-inner.sh)
# survived the merge; merge_config.sh silently drops options with unmet deps.

# --- Debug info: DWARF is consumed by pahole to produce vmlinux.btf ---
CONFIG_DEBUG_KERNEL=y
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_DWARF5=y
# CONFIG_DEBUG_INFO_DWARF4 is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set
# CONFIG_GDB_SCRIPTS is not set
CONFIG_KALLSYMS=y

# --- Memory layout / paging: the web inspector walks 2-level i386 tables ---
# CONFIG_RANDOMIZE_BASE is not set
# CONFIG_X86_PAE is not set
CONFIG_NOHIGHMEM=y
# CONFIG_HIGHMEM4G is not set
# CONFIG_HIGHMEM64G is not set
CONFIG_VMSPLIT_3G=y
# CONFIG_VMSPLIT_2G is not set
# CONFIG_VMSPLIT_1G is not set
# CONFIG_MITIGATION_PAGE_TABLE_ISOLATION is not set
# CONFIG_MITIGATION_RETPOLINE is not set
# CONFIG_MITIGATION_SPECTRE_BHI is not set
# CONFIG_MITIGATION_RFDS is not set
# CONFIG_MITIGATION_SLS is not set
# CONFIG_MITIGATION_ITS is not set

# --- Single CPU, no APIC (v86 has one CPU; PIC + PIT are enough) ---
# PCI_MSI forces X86_UP_APIC on, so it has to go too
# CONFIG_PCI_MSI is not set
# CONFIG_SMP is not set
# CONFIG_X86_UP_APIC is not set
# CONFIG_X86_UP_IOAPIC is not set
# CONFIG_X86_LOCAL_APIC is not set
# CONFIG_X86_IO_APIC is not set
# CONFIG_ACPI is not set
# CONFIG_X86_MCE is not set
# CONFIG_MICROCODE is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_HYPERVISOR_GUEST is not set
# CONFIG_X86_EXTENDED_PLATFORM is not set
# CONFIG_X86_INTEL_MPX is not set
CONFIG_HZ_100=y
# CONFIG_HZ_250 is not set
CONFIG_HZ=100

# --- Scheduler: every CFS sched_entity is a task ---
# CONFIG_CGROUPS is not set
# CONFIG_CGROUP_SCHED is not set
# CONFIG_FAIR_GROUP_SCHED is not set
# CONFIG_RT_GROUP_SCHED is not set
# CONFIG_SCHED_AUTOGROUP is not set
# CONFIG_SCHED_CORE is not set
# CONFIG_UCLAMP_TASK is not set
# (CONFIG_SCHED_DEBUG needs DEBUG_FS, which we disable; not required by the inspector)

# --- Console / boot / filesystems ---
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_CORE=y
CONFIG_SERIAL_CORE_CONSOLE=y
CONFIG_PRINTK=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_BINFMT_ELF=y
CONFIG_UNIX98_PTYS=y
# CONFIG_LEGACY_PTYS is not set
# CONFIG_VT is not set
# CONFIG_VGA_CONSOLE is not set
# CONFIG_FB is not set
# CONFIG_MODULES is not set
# CONFIG_KEXEC is not set
# CONFIG_HIBERNATION is not set
# CONFIG_SUSPEND is not set
# CONFIG_PM is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CPU_IDLE is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_STACKPROTECTOR is not set
# CONFIG_X86_DEBUG_FPU is not set

# --- Drop bloat: network, sound, graphics, wireless, USB, storage, input ---
# CONFIG_NET is not set
# CONFIG_NETFILTER is not set
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_SOUND is not set
# CONFIG_SND is not set
# CONFIG_DRM is not set
# CONFIG_AGP is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_USB is not set
# CONFIG_INPUT is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_EVDEV is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_MD is not set
# CONFIG_NETDEVICES is not set
# CONFIG_ETHERNET is not set
# CONFIG_PCCARD is not set
# CONFIG_HID is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_RTC_CLASS is not set
# CONFIG_HWMON is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VIRTIO is not set
# CONFIG_9P_FS is not set
# CONFIG_NETWORK_FILESYSTEMS is not set
# CONFIG_EXT4_FS is not set
# CONFIG_EXT2_FS is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_ISO9660_FS is not set
# CONFIG_VFAT_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_CIFS is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_IKCONFIG is not set
